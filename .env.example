# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# --- Provider selection ---
# "openai"/"anthropic" (default) or "gemini" for both. Switching providers
# never requires touching route/retrieval/prompt code -- see
# app/services/embeddings.py and app/services/llm.py.
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=anthropic

# --- OpenAI (used when EMBEDDING_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=claude-sonnet-5

# --- Gemini (used when EMBEDDING_PROVIDER=gemini and/or LLM_PROVIDER=gemini) ---
# Free tier: https://aistudio.google.com/apikey -- one key covers both
# embeddings and chat generation.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.6-flash

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=4

# --- Storage paths ---
UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=vector_db
CHROMA_COLLECTION_NAME=documents

# --- Limits ---
MAX_UPLOAD_MB=25
