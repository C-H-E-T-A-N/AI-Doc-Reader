# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# --- Provider selection ---
# EMBEDDING_PROVIDER: "openai" (default) | "gemini" | "local" (on-device, no key)
# LLM_PROVIDER:       "anthropic" (default) | "openai" | "gemini" | "groq"
# Switching providers never requires touching route/retrieval/prompt
# code -- see app/services/embeddings.py and app/services/llm.py.
# Note: changing EMBEDDING_PROVIDER changes the vector size, so wipe
# vector_db/ + data/registry.json and re-upload after switching.
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=anthropic

# --- OpenAI (used when EMBEDDING_PROVIDER=openai and/or LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Local embeddings (used when EMBEDDING_PROVIDER=local) ---
# No key. Downloads all-MiniLM-L6-v2 ONNX (~80 MB) once, then runs offline.
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Groq (used when LLM_PROVIDER=groq) ---
# Free tier, no credit card. Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_MODEL=claude-sonnet-5

# --- Gemini (used when EMBEDDING_PROVIDER=gemini and/or LLM_PROVIDER=gemini) ---
# Free tier: https://aistudio.google.com/apikey -- one key covers both
# embeddings and chat generation.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.6-flash

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K=4

# --- Storage paths ---
UPLOAD_DIR=data/uploads
VECTOR_DB_DIR=vector_db
CHROMA_COLLECTION_NAME=documents

# --- Limits ---
MAX_UPLOAD_MB=25
